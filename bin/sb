#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SAUTI_ROOT="${SAUTI_ROOT:-$DEFAULT_ROOT}"

usage() {
  cat <<'USAGE'
usage: sb {setup|dev} [args...]

Commands:
  setup   Run bin/setup with RAILS_ENV=development (installs deps, seeds DB)
  dev     Start the Procfile.dev stack via bin/dev

Set SAUTI_ROOT to override the repository path if you keep the code elsewhere.
USAGE
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

action="$1"
shift || true

if [[ ! -d "$SAUTI_ROOT" ]]; then
  echo "sb: repository not found at $SAUTI_ROOT" >&2
  exit 1
fi

case "$action" in
  setup)
    (cd "$SAUTI_ROOT" && RAILS_ENV="${RAILS_ENV:-development}" bin/setup "$@")
    ;;
  dev)
    (cd "$SAUTI_ROOT" && bin/dev "$@")
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "sb: unknown command '$action'" >&2
    usage >&2
    exit 1
    ;;
esac
